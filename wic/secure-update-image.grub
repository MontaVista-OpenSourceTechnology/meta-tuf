serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1
default=boot1
timeout=5

menuentry 'boot1'{
linux /bzImage root=PARTUUID=8299e0f2-c395-4619-a0a0-442f6883d188 rootwait rootfstype=ext4 console=ttyS0,115200 console=tty0
}

menuentry 'boot2'{
linux /bzImage root=PARTUUID=7d4a0c56-dfa3-4dc3-ac00-a41e8d5d6413 rootwait rootfstype=ext4 console=ttyS0,115200 console=tty0
}
